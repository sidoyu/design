{
  "$description": "sidoyu design system — 단일 원본 토큰. 이 파일만 손으로 편집한다. dist/는 scripts/build-tokens.mjs가 생성한다.",
  "meta": {
    "name": "sidoyu-design",
    "version": "0.5.0"
  },
  "color": {
    "$description": "UI 시맨틱 색. 차트 데이터 색은 chart 그룹에 격리 — UI에 차트 색을 쓰지 말 것.",
    "brand": {
      "$type": "color",
      "$value": "#28FF35",
      "$description": "시그니처 네온 그린. 포인트 전용: 호버 틴트·링크 밑줄·선택영역·포커스 링. 넓은 면 배경·텍스트 색으로 금지(흰 배경 대비 1.36:1)."
    },
    "brand-hover": {
      "$type": "color",
      "$value": "rgba(40, 255, 53, 0.12)",
      "$description": "인터랙티브 요소 호버 배경 틴트. brand와 같은 RGB여야 한다(빌드가 검증). 기존 --brand-8 승계."
    },
    "brand-selection": {
      "$type": "color",
      "$value": "rgba(40, 255, 53, 0.22)",
      "$description": "텍스트 선택영역 배경. brand와 같은 RGB여야 한다(빌드가 검증). 기존 --brand-16 승계."
    },
    "ink": {
      "$type": "color",
      "$value": "#000000",
      "$description": "기본 텍스트·제목·solid 버튼 배경."
    },
    "ink-muted": {
      "$type": "color",
      "$value": "rgba(0, 0, 0, 0.70)",
      "$description": "보조 본문·설명. 흰 배경 대비 ≈7.3:1. 기존 /70·/60 통합."
    },
    "ink-faint": {
      "$type": "color",
      "$value": "rgba(0, 0, 0, 0.55)",
      "$description": "메타 정보·라벨·날짜. 흰 배경 대비 ≈4.6:1 (AA 텍스트 최소 통과). 기존 /50·/45·/40 통합 — 텍스트의 하한선. 이보다 옅은 텍스트 금지(더 보조적인 텍스트는 색이 아니라 크기·위계·간격으로)."
    },
    "surface": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "페이지·카드 배경. 라이트 전용 시스템."
    },
    "surface-subtle": {
      "$type": "color",
      "$value": "rgba(0, 0, 0, 0.03)",
      "$description": "테이블 헤더·코드 블록 등 미세 구분 배경. 기존 bg-black/[.03]·/5 통합."
    },
    "line": {
      "$type": "color",
      "$value": "rgba(0, 0, 0, 0.10)",
      "$description": "기본 테두리: 카드·입력·구분선. 기존 border-black/10·/15·/20 통합."
    }
  },
  "container": {
    "wide": {
      "$type": "dimension",
      "$value": "64rem",
      "$description": "1024px. 카드 그리드 페이지(홈·플레이그라운드). 기존 max-w-5xl."
    },
    "reading": {
      "$type": "dimension",
      "$value": "48rem",
      "$description": "768px. 글·리스트·대시보드(블로그·뉴스레터·프로젝트·통계). 기존 max-w-3xl. (Tailwind 기본 max-w-prose와 충돌을 피해 prose 대신 reading)"
    },
    "narrow": {
      "$type": "dimension",
      "$value": "28rem",
      "$description": "448px. 폼·연락처. 기존 max-w-md."
    }
  },
  "motion": {
    "$description": "전환은 transition-colors 하나, 기본 150ms(Tailwind 기본값) 그대로. 이동·확대 애니메이션은 쓰지 않는다. CSS 재발행 없음 — 문서·Figma용.",
    "$extensions": {
      "com.sidoyu": {
        "emitCss": false
      }
    },
    "duration-fast": {
      "$type": "duration",
      "$value": "150ms",
      "$description": "유일한 전환 속도."
    }
  },
  "typography": {
    "$description": "Tailwind 기본 스케일을 그대로 쓰되 이 6단만 허용. CSS로 재발행하지 않음 — Figma·문서용.",
    "$extensions": {
      "com.sidoyu": {
        "emitCss": false
      }
    },
    "font-sans": {
      "$type": "fontFamily",
      "$value": "Geist",
      "$description": "본문·제목. next/font 로딩, 앱 glue에서 --font-geist-sans 연결."
    },
    "font-mono": {
      "$type": "fontFamily",
      "$value": "Geist Mono",
      "$description": "코드·표 숫자(tabular-nums 병용)."
    },
    "size-xs": {
      "$type": "dimension",
      "$value": "0.75rem",
      "$description": "12px. 메타·라벨·배지."
    },
    "size-sm": {
      "$type": "dimension",
      "$value": "0.875rem",
      "$description": "14px. 본문 기본·설명."
    },
    "size-base": {
      "$type": "dimension",
      "$value": "1rem",
      "$description": "16px. 긴 글 본문(prose 영역)."
    },
    "size-lg": {
      "$type": "dimension",
      "$value": "1.125rem",
      "$description": "18px. 섹션 제목."
    },
    "size-2xl": {
      "$type": "dimension",
      "$value": "1.5rem",
      "$description": "24px. 페이지 제목."
    },
    "size-3xl": {
      "$type": "dimension",
      "$value": "1.875rem",
      "$description": "30px. 대시보드 KPI 숫자 한정."
    }
  },
  "chart": {
    "$description": "데이터 시각화 전용 팔레트. UI 색과 격리 — 판독성 우선. dist/chart-palette.ts로 발행되어 앱에 복사된다.",
    "$extensions": {
      "com.sidoyu": {
        "emitCss": false
      }
    },
    "family": {
      "$description": "AI 모델 패밀리 고정 색 (stats 누적 영역 차트·테이블 도트).",
      "claude-fable": {
        "$type": "color",
        "$value": "#D97706"
      },
      "claude-opus": {
        "$type": "color",
        "$value": "#16A34A"
      },
      "claude-sonnet": {
        "$type": "color",
        "$value": "#4F46E5"
      },
      "claude-haiku": {
        "$type": "color",
        "$value": "#0891B2"
      },
      "codex": {
        "$type": "color",
        "$value": "#EA580C"
      },
      "claude-api": {
        "$type": "color",
        "$value": "#7C3AED"
      },
      "gpt-api": {
        "$type": "color",
        "$value": "#0EA5E9"
      },
      "gemini": {
        "$type": "color",
        "$value": "#DB2777"
      },
      "grok": {
        "$type": "color",
        "$value": "#525252"
      },
      "replicate": {
        "$type": "color",
        "$value": "#E11D48"
      },
      "other": {
        "$type": "color",
        "$value": "#A3A3A3"
      }
    },
    "heatmap": {
      "$description": "활동 히트맵 5단계 (GitHub 잔디 스타일 유지 — 브랜드 그린 미사용 결정: 대비 미달). 셀은 직각(v0.3.0 플랫 전환).",
      "level-0": {
        "$type": "color",
        "$value": "#EBEDF0"
      },
      "level-1": {
        "$type": "color",
        "$value": "#C6E9C9"
      },
      "level-2": {
        "$type": "color",
        "$value": "#86D993"
      },
      "level-3": {
        "$type": "color",
        "$value": "#3FB55C"
      },
      "level-4": {
        "$type": "color",
        "$value": "#16A34A"
      }
    },
    "token-composition": {
      "$description": "토큰 구성 막대.",
      "input": {
        "$type": "color",
        "$value": "#4F46E5"
      },
      "output": {
        "$type": "color",
        "$value": "#16A34A"
      },
      "cache-read": {
        "$type": "color",
        "$value": "#0891B2"
      },
      "cache-write": {
        "$type": "color",
        "$value": "#A3A3A3"
      }
    },
    "axis": {
      "$description": "축·그리드는 UI ink 계열과 동일 값 사용(시각 통일).",
      "grid": {
        "$type": "color",
        "$value": "rgba(0, 0, 0, 0.06)"
      },
      "tick": {
        "$type": "color",
        "$value": "rgba(0, 0, 0, 0.55)"
      }
    }
  },
  "email": {
    "$description": "트랜잭션 메일(Resend)용. 메일 클라이언트는 CSS 변수 미지원 — 이 hex를 인라인으로 직접 쓴다.",
    "$extensions": {
      "com.sidoyu": {
        "emitCss": false
      }
    },
    "text": {
      "$type": "color",
      "$value": "#111111"
    },
    "text-muted": {
      "$type": "color",
      "$value": "#666666"
    },
    "background": {
      "$type": "color",
      "$value": "#FFFFFF"
    }
  }
}
